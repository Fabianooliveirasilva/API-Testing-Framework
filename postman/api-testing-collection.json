{
  "info": {
    "_postman_id": "d0d5f0d7-0b44-4c7a-8b84-7b6e4a70f4b1",
    "name": "Restful Booker API - Exploratory Collection",
    "description": "Manual and exploratory coverage that complements the automated Playwright suite. Statuses marked observed are based on docs/api-behavior-notes.md and may change as the public service changes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const expectedStatus = pm.variables.get('expectedStatus');",
          "pm.test(`status is ${expectedStatus}`, () => pm.response.to.have.status(Number(expectedStatus)));",
          "pm.test('response time is a recorded measurement', () => pm.expect(pm.response.responseTime).to.be.a('number').and.to.be.at.least(0));",
          "pm.test('content type is present', () => pm.expect(pm.response.headers.get('Content-Type')).to.be.a('string').and.not.empty);"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://restful-booker.herokuapp.com"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Create token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{username}}\",\"password\":\"{{password}}\"}"
            },
            "url": "{{baseUrl}}/auth",
            "description": "Documented authentication flow. Credentials are read from the environment and are never logged."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('response has a token string', () => { pm.expect(body).to.have.property('token'); pm.expect(body.token).to.be.a('string').and.not.empty; });",
                  "pm.collectionVariables.set('token', body.token);",
                  "pm.environment.set('token', body.token);"
                ]
              }
            }
          ],
          "variable": [
            {
              "key": "expectedStatus",
              "value": "200"
            }
          ]
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Get all",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/booking",
            "description": "Documented list endpoint. Do not assert shared-list count or contents; only assert the array and item types."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('response is a booking ID array', () => { pm.expect(body).to.be.an('array'); body.forEach(item => { pm.expect(item).to.have.property('bookingid'); pm.expect(item.bookingid).to.be.a('number'); }); });"
                ]
              }
            }
          ],
          "variable": [
            {
              "key": "expectedStatus",
              "value": "200"
            }
          ]
        },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"firstname\":\"Postman Exploratory\",\"lastname\":\"Booking\",\"totalprice\":120,\"depositpaid\":true,\"bookingdates\":{\"checkin\":\"2025-01-01\",\"checkout\":\"2025-01-10\"},\"additionalneeds\":\"Breakfast\"}"
            },
            "url": "{{baseUrl}}/booking",
            "description": "Documented creation request. The generated booking ID is saved before response assertions so later requests and cleanup use only this resource."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('bookingId', String(body.bookingid));",
                  "pm.environment.set('bookingId', String(body.bookingid));",
                  "pm.test('response has booking ID and booking object', () => { pm.expect(body.bookingid).to.be.a('number'); pm.expect(body.booking).to.be.an('object'); pm.expect(body.booking.firstname).to.be.a('string'); pm.expect(body.booking.bookingdates.checkin).to.be.a('string'); });"
                ]
              }
            }
          ],
          "variable": [
            {
              "key": "expectedStatus",
              "value": "200"
            }
          ]
        },
        {
          "name": "Get by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/booking/{{bookingId}}",
            "description": "Documented retrieval of the booking created by this collection."
          },
          "event": [
